# --- Generative layer ---
# Which provider synthesizes the cards: auto | gemini | rules.
# "auto" uses Gemini if its key is set, else the deterministic rules fallback.
LLM_PROVIDER=auto

# Google Gemini — FREE tier, no credit card needed.
# Get a key at https://aistudio.google.com/apikey  (recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# --- GitHub ---
# Optional personal access token: raises the public rate limit (60 -> 5000/hr)
# and enables ingesting private repos. Generate at github.com/settings/tokens.
GITHUB_TOKEN=

# --- GitHub OAuth app (optional — username ingestion works without it) ---
# Create at github.com/settings/developers. Callback URL must be:
#   http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- URLs ---
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# --- Storage ---
# SQLite for local dev; swap for a Postgres DSN in production.
# With ENVIRONMENT=production the app refuses to start on anything but Postgres,
# because SQLite on an ephemeral container loses every share link on redeploy.
DATABASE_URL=sqlite:///./proof.db

# --- Environment ---
# development | production. "production" turns silent misconfigurations
# (SQLite storage, missing GITHUB_TOKEN) into hard startup failures.
ENVIRONMENT=development

# --- Cost and abuse controls ---
# Repos ingested per profile, ranked by stars then recency. Each repo costs
# ~9 GitHub calls (languages + README + 7 manifests), so this is the main lever
# on latency and rate-limit burn.
MAX_REPOS=15

# Serve a stored profile instead of regenerating when it's younger than this.
# Repeat traffic to a shared résumé link then costs one DB read, not an ingest.
PROFILE_CACHE_HOURS=24

# Cold generates allowed per caller per hour, and across all callers per hour.
# Only cache MISSES count, so repeat traffic to a shared link is never charged.
GENERATE_RATE_LIMIT=30
GENERATE_GLOBAL_HOURLY_CAP=1000

# --- Concurrency ---
# In-flight GitHub requests per ingest. Higher finishes one profile sooner but
# bursts harder against the hourly token budget.
GITHUB_CONCURRENCY=16
# Postgres pool ceiling. Keep under your provider's per-database connection cap.
DB_POOL_MAX_SIZE=16
