# --- Generative layer ---
# Which provider synthesizes the cards: auto | gemini | claude | rules.
# "auto" uses Gemini if its key is set, then Claude, else the rules fallback.
LLM_PROVIDER=auto

# Google Gemini — FREE tier, no credit card needed.
# Get a key at https://aistudio.google.com/apikey  (recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — optional paid alternate.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- GitHub ---
# Optional personal access token: raises the public rate limit (60 -> 5000/hr)
# and enables ingesting private repos. Generate at github.com/settings/tokens.
GITHUB_TOKEN=

# --- GitHub OAuth app (optional — username ingestion works without it) ---
# Create at github.com/settings/developers. Callback URL must be:
#   http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- URLs ---
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# --- Storage ---
# SQLite for local dev; swap for a Postgres DSN in production.
DATABASE_URL=sqlite:///./proof.db

# Number of repos to ingest per profile (ranked by stars then recency).
MAX_REPOS=50

# --- Abuse protection / production ---
# Fresh generations allowed per client IP per window (seconds).
GENERATE_RATE_LIMIT=5
GENERATE_RATE_WINDOW=600
# Re-requests for the same username within this many seconds are served from
# the stored copy (requests that include a token always regenerate).
REGENERATE_COOLDOWN=600
# Max seconds for one LLM call before falling back to the rules deck.
LLM_TIMEOUT=90
# Interactive API docs at /docs. Set false in production.
ENABLE_DOCS=true
# Repos per LLM request; batches run in parallel (faster decks, more requests
# against the provider's per-minute quota).
LLM_BATCH_SIZE=12

# --- Scaling / load balancing ---
# Shared Redis (e.g. Upstash free tier) for rate limits, cooldowns and
# per-username locks. Required before running WEB_CONCURRENCY > 1 or more than
# one instance behind a load balancer. Empty = in-process memory.
REDIS_URL=
# Uvicorn worker processes per instance (read by uvicorn itself). Keep 1
# unless REDIS_URL and a Postgres DATABASE_URL are set.
WEB_CONCURRENCY=1
